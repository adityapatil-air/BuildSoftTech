# Copy to .env.local and fill in.
# Password for the single admin login at /admin
ADMIN_PASSWORD=
# Random string used to sign the admin session cookie (any long random value)
ADMIN_SECRET=
# Optional: persistent settings storage for production (Vercel). Without these,
# settings are written to .data/settings.json, which does not persist on Vercel.
# Create a table:  site_settings (key text primary key, value jsonb)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
